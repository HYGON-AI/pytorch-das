   if (domain == ACTIVITY_DOMAIN_HIP_API && dis->loggedIds_.contains(cid)) {
@@ -127,6 +128,7 @@ void RoctracerLogger::api_callback(
         {
           s_flush.reportCorrelation(data->correlation_id);
           auto& args = data->args.hipLaunchKernel;
+          std::string kernelName = "";
           rocprofKernelRow* row = new rocprofKernelRow(
               data->correlation_id,
               domain,
@@ -144,7 +146,8 @@ void RoctracerLogger::api_callback(
               args.dimBlocks.y,
               args.dimBlocks.z,
               args.sharedMemBytes,
-              args.stream);
+              args.stream,
