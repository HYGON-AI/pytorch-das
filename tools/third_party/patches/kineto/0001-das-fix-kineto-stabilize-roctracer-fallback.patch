From e62e34bcb3994b3b88c41342200ee6892531c59a Mon Sep 17 00:00:00 2001
Date: Wed, 15 Jul 2026 15:53:17 +0800
Subject: [PATCH 1/2] [das] fix(kineto): stabilize roctracer fallback

Why:
ROCtracer fallback builds need to avoid Rocprof registration and preserve kernel names before deferred activity serialization.

What:
Store captured kernel names, avoid unused-parameter warnings, and skip Rocprof initialization when ROCTRACER_FALLBACK is enabled.

Impact:
ROCtracer module launches use the captured kernel name. This patch mirrors the existing third-party ZIP changes.
---
 libkineto/src/RocLogger.h              |  4 +++-
 libkineto/src/RoctracerActivityApi.cpp |  1 +
 libkineto/src/RoctracerActivity_inl.h  |  5 ++---
 libkineto/src/RoctracerLogger.cpp      | 10 ++++++++--
 libkineto/src/init.cpp                 |  6 ++++--
 5 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/libkineto/src/RocLogger.h b/libkineto/src/RocLogger.h
index a59ffad..f7f2e74 100644
--- a/libkineto/src/RocLogger.h
+++ b/libkineto/src/RocLogger.h
@@ -123,6 +123,7 @@ struct rocprofKernelRow : public rocprofRow {
                    unsigned int wz,
                    size_t gss,
                    hipStream_t stream,
+                   const std::string& kernelName_,
                    rocprof_activity_types type = ROCTRACER_ACTIVITY_KERNEL)
       : rocprofRow(id, domain, cid, pid, tid, begin, end, type),
         functionAddr(faddr),
@@ -134,7 +135,7 @@ struct rocprofKernelRow : public rocprofRow {
         workgroupY(wy),
         workgroupZ(wz),
         groupSegmentSize(gss),
-        stream(stream) {}
+        stream(stream), kernelName(kernelName_) {}
   const void* functionAddr;
   hipFunction_t function;
   unsigned int gridX;
@@ -145,6 +146,7 @@ struct rocprofKernelRow : public rocprofRow {
   unsigned int workgroupZ;
   size_t groupSegmentSize;
   hipStream_t stream;
+  std::string kernelName;
 };

 struct rocprofCopyRow : public rocprofRow {
diff --git a/libkineto/src/RoctracerActivityApi.cpp b/libkineto/src/RoctracerActivityApi.cpp
index 709a89d..7b1b5ad 100644
--- a/libkineto/src/RoctracerActivityApi.cpp
+++ b/libkineto/src/RoctracerActivityApi.cpp
@@ -55,6 +55,7 @@ void RoctracerActivityApi::popCorrelationID(CorrelationFlowType type) {
 }

 void RoctracerActivityApi::setMaxBufferSize(int64_t size) {
+  (void)size;
   // FIXME: implement?
   // maxGpuBufferCount_ = 1 + size / kBufSize;
 }
diff --git a/libkineto/src/RoctracerActivity_inl.h b/libkineto/src/RoctracerActivity_inl.h
index 6f1e752..9fb01c8 100644
--- a/libkineto/src/RoctracerActivity_inl.h
+++ b/libkineto/src/RoctracerActivity_inl.h
@@ -161,11 +161,10 @@ inline const std::string RuntimeActivity<rocprofKernelRow>::metadataJson() const
         R"JSON(
     "kernel": "{}", )JSON",
         demangle(hipKernelNameRefByPtr(raw().functionAddr, raw().stream)));
-  } else if ((raw().function != nullptr)) {
+  } else if ((raw().function != nullptr)&&!raw().kernelName.empty()) {
     kernel = fmt::format(
         R"JSON(
-    "kernel": "{}", )JSON",
-        demangle(hipKernelNameRef(raw().function)));
+    "kernel": "{}", )JSON", raw().kernelName);
   }
   // cache grid and block so we can pass it into async activity (GPU track)
   correlationToGrid[raw().id] = fmt::format(
diff --git a/libkineto/src/RoctracerLogger.cpp b/libkineto/src/RoctracerLogger.cpp
