         case HIP_API_ID_hipHccModuleLaunchKernel:
@@ -152,6 +155,7 @@ void RoctracerLogger::api_callback(
         case HIP_API_ID_hipExtModuleLaunchKernel: {
           s_flush.reportCorrelation(data->correlation_id);
           auto& args = data->args.hipModuleLaunchKernel;
+          std::string kernelName = demangle(hipKernelNameRef(args.f));
           rocprofKernelRow* row = new rocprofKernelRow(
               data->correlation_id,
               domain,
@@ -169,7 +173,8 @@ void RoctracerLogger::api_callback(
               args.blockDimY,
               args.blockDimZ,
               args.sharedMemBytes,
-              args.stream);
+              args.stream,
+              kernelName);
           insert_row_to_buffer(row);
         } break;
         case HIP_API_ID_hipLaunchCooperativeKernelMultiDevice:
@@ -292,6 +297,7 @@ void RoctracerLogger::activity_callback(
     const char* begin,
     const char* end,
     void* arg) {
+  (void)arg;
   // Log latest completed correlation id.  Used to ensure we have flushed all
   // data on stop
   std::unique_lock<std::mutex> lock(s_flush.mutex_);
