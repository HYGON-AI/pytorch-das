 libkineto/src/RoctracerActivity.h      |  2 +-
 libkineto/src/RoctracerActivityApi.cpp |  6 +--
 libkineto/src/RoctracerLogger.cpp      | 64 ++++++++++++++------------
 libkineto/src/RoctracerLogger.h        |  4 +-
 5 files changed, 41 insertions(+), 36 deletions(-)

