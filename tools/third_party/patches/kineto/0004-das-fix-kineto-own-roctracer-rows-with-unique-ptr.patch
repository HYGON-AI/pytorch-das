@@ -88,6 +88,7 @@ struct rocprofBase {
   // - roctracer fallback: activity_domain_t
   uint32_t domain;
   rocprof_activity_types type;
+  virtual ~rocprofBase() = default;
 };

 struct rocprofRow : public rocprofBase {
